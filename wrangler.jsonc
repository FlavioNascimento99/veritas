{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veritas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SPRING_PROFILES_ACTIVE": "prod",
    // Pooler Supabase (modo transaction). NÃO voltar para 5432 aqui:
    // o host direto db.*.supabase.co não é confiável a partir de Containers.
    "PGPORT": "6543",
    "PGDATABASE": "postgres"
  },
  "containers": [
    {
      "class_name": "VeritasContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "name": "veritas-app",
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "VeritasContainer",
        "name": "VERITAS_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["VeritasContainer"],
      "tag": "v1"
    }
  ]
}
